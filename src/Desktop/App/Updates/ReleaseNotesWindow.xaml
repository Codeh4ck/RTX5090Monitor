<Window
    x:Class="RTXLens.App.Updates.ReleaseNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RTX Lens - Release notes">
    <Grid x:Name="Root" Background="{ThemeResource MonitorBackground}" Padding="18">
        <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="NotesCard" Style="{StaticResource MonitorCard}" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="VersionText" Style="{StaticResource MonitorHeading}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource MonitorCaption}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Name="DownloadLink" Content="Download ZIP"
                                Foreground="{ThemeResource MonitorAccent}" Visibility="Collapsed" />
                            <HyperlinkButton x:Name="ReleaseLink" Content="Open release"
                                Foreground="{ThemeResource MonitorAccent}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="MarkdownBody" Spacing="10" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>

