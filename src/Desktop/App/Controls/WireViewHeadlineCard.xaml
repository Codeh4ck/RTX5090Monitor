<UserControl x:Class="RTXLens.App.Controls.WireViewHeadlineCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RTXLens.App.Controls">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Fault">
                    <VisualState.Setters>
                        <Setter Target="HeadlineCard.Background" Value="{ThemeResource MonitorDangerSurface}" />
                        <Setter Target="HeadlineCard.BorderBrush" Value="{ThemeResource MonitorDanger}" />
                        <Setter Target="HeadlineLabel.Foreground" Value="{ThemeResource MonitorDanger}" />
                        <Setter Target="HeadlineValue.Foreground" Value="{ThemeResource MonitorDanger}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="HeadlineCard" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:WidgetIcon IconName="{Binding IconName}" Tone="{Binding Tone}" Width="20" Height="20" />
                    <TextBlock x:Name="HeadlineLabel" Grid.Column="1" Text="{Binding Label}"
                        Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="HeadlineValue" Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

