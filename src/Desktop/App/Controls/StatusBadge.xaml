<UserControl x:Class="Rtx5090Monitoring.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Positive"><VisualState.Setters>
                    <Setter Target="Frame.Background" Value="{ThemeResource MonitorSuccessSurface}" />
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource MonitorSuccess}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource MonitorSuccess}" />
                    <Setter Target="Dot.Fill" Value="{ThemeResource MonitorSuccess}" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Caution"><VisualState.Setters>
                    <Setter Target="Frame.Background" Value="{ThemeResource MonitorCautionSurface}" />
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource MonitorCaution}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource MonitorCaution}" />
                    <Setter Target="Dot.Fill" Value="{ThemeResource MonitorCaution}" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Negative"><VisualState.Setters>
                    <Setter Target="Frame.Background" Value="{ThemeResource MonitorDangerSurface}" />
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource MonitorDanger}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource MonitorDanger}" />
                    <Setter Target="Dot.Fill" Value="{ThemeResource MonitorDanger}" />
                </VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Frame" Background="{ThemeResource MonitorTrack}" BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="1" CornerRadius="14" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{ThemeResource MonitorMuted}" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Foreground="{ThemeResource MonitorMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
