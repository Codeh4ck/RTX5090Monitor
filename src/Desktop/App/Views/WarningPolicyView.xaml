<UserControl x:Class="Rtx5090Monitoring.App.Views.WarningPolicyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <CheckBox Content="Notify when a warning starts" IsChecked="{x:Bind Model.NotifyOnStart, Mode=TwoWay}" />
        <CheckBox Content="Repeat while warning remains active" IsChecked="{x:Bind Model.RepeatWhileActive, Mode=TwoWay}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <NumberBox Header="Repeat every (seconds)" Value="{x:Bind Model.RepeatIntervalSeconds, Mode=TwoWay}" Minimum="5" Maximum="3600"
                SmallChange="1" SpinButtonPlacementMode="Inline" IsEnabled="{x:Bind Model.RepeatWhileActive, Mode=OneWay}" />
            <NumberBox Grid.Column="1" Header="Condition must remain clear for (seconds)" Value="{x:Bind Model.ClearAfterSeconds, Mode=TwoWay}" Minimum="0" Maximum="60"
                SmallChange="1" SpinButtonPlacementMode="Inline" />
        </Grid>
    </StackPanel>
</UserControl>
