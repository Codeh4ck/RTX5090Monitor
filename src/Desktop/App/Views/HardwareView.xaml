<UserControl x:Class="RTXLens.App.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RTXLens.App.Controls"
    xmlns:telemetry="using:RTXLens.Presentation.Telemetry"
    xmlns:converters="using:RTXLens.App.Converters">
    <UserControl.Resources>
        <converters:BooleanVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="WireViewHeadline" x:DataType="telemetry:MetricViewModel">
            <controls:WireViewHeadlineCard Tone="{x:Bind Tone, Mode=OneWay}" />
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="HardwareScroll" HorizontalScrollBarVisibility="Disabled" Padding="12,12">
        <StackPanel Spacing="12">
            <Grid x:Name="DeviceHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                <StackPanel x:Name="DeviceIdentity" Orientation="Horizontal" Spacing="12">
                    <controls:WidgetIcon IconName="{x:Bind DeviceIconName}" Width="42" Height="42" VerticalAlignment="Center" />
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind Model.Name}" Style="{StaticResource MonitorHeading}" />
                        <TextBlock Text="{x:Bind Model.DeviceText, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
                        
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="DeviceActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RestartButton" Click="Restart_Click" AutomationProperties.Name="Restart plugin" Visibility="{x:Bind Model.CanRestart, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/refresh.svg" /></Image.Source>
                            </Image>
                            <TextBlock Text="Restart plugin" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeviceSettingsButton" Click="ReadDevice_Click" AutomationProperties.Name="Device settings..." Visibility="{x:Bind Model.CanReadDevice, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/settings-action.svg" /></Image.Source>
                            </Image>
                            <TextBlock Text="Device settings..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearFaultsButton" Click="ClearFaults_Click" AutomationProperties.Name="Clear faults" Visibility="{x:Bind Model.ShowClearFaults, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/chart-clear.svg" /></Image.Source>
                            </Image>
                            <TextBlock Text="Clear faults" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <controls:StatusBadge Text="{x:Bind Model.State, Mode=OneWay}" Tone="{x:Bind Model.Tone, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Message, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="FaultsHost" Spacing="8" Visibility="{x:Bind Model.HasFaults, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
            <InfoBar IsOpen="{x:Bind Model.HasWarning, Mode=OneWay}" IsClosable="False" Severity="Error"
                Visibility="{x:Bind Model.IsAsus, Converter={StaticResource BoolVisibility}}" Title="Hardware warning" Message="{x:Bind Model.WarningText, Mode=OneWay}" />
            <Grid x:Name="HeadlineGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12">
                <ContentControl Content="{x:Bind Model.CableRating}" ContentTemplate="{StaticResource WireViewHeadline}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Visibility="{x:Bind Model.IsWireView, Converter={StaticResource BoolVisibility}}" />
                <Border Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:WidgetIcon IconName="pin" Width="20" Height="20" />
                            <TextBlock Text="CONNECTOR POWER" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="{x:Bind Model.PowerText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:WidgetIcon IconName="overcurrent" Width="20" Height="20" />
                            <TextBlock Text="TOTAL CURRENT" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="{x:Bind Model.CurrentText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:WidgetIcon IconName="voltage" Width="20" Height="20" />
                            <TextBlock Text="VOLTAGE" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" /></StackPanel>
                        <TextBlock Text="{x:Bind Model.VoltageText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <ContentControl Content="{x:Bind Model.FaultStatus}" ContentTemplate="{StaticResource WireViewHeadline}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Visibility="{x:Bind Model.IsWireView, Converter={StaticResource BoolVisibility}}" />
                <ContentControl Content="{x:Bind Model.FaultLogStatus}" ContentTemplate="{StaticResource WireViewHeadline}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Visibility="{x:Bind Model.IsWireView, Converter={StaticResource BoolVisibility}}" />
            </Grid>
            <Grid x:Name="TelemetryGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,0" RowSpacing="14">
                <Border Style="{StaticResource MonitorCard}" VerticalAlignment="Top"
                    Visibility="{x:Bind Model.HasPins, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <controls:WidgetIcon IconName="pin" Width="28" Height="28" />
                                <TextBlock Text="Pin distribution" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="4">
                                <Button Content="A" Click="Current_Click" AutomationProperties.Name="Show pin current" />
                                <Button Content="W" Click="Power_Click" AutomationProperties.Name="Show pin power" />
                                <Button Content="V" Click="Voltage_Click" AutomationProperties.Name="Show pin voltage" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Background="{ThemeResource MonitorInset}" BorderBrush="{ThemeResource MonitorPeak}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CURRENT SPREAD (Δ)" Foreground="{ThemeResource MonitorPeak}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Model.CurrentSpreadText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Max − min current" Style="{StaticResource MonitorCaption}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource MonitorInset}" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="8"><TextBlock Text="HIGHEST PIN" Style="{StaticResource MonitorCaption}" FontSize="10" />
                                    <TextBlock Text="{x:Bind Model.HighestCurrentText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource MonitorInset}" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="8"><TextBlock Text="LOWEST PIN" Style="{StaticResource MonitorCaption}" FontSize="10" />
                                    <TextBlock Text="{x:Bind Model.LowestCurrentText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="CURRENT HEADROOM TO LIMIT" Style="{StaticResource MonitorCaption}" FontSize="10"
                            HorizontalAlignment="Center" Visibility="{x:Bind Model.ShowHeadroom, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                        <Grid x:Name="PinHost" ColumnDefinitions="48,*,*,*,*,*,*" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{x:Bind Model.PsuComparisonLabel, Mode=OneWay}" Style="{StaticResource MonitorCaption}" FontSize="10"
                            HorizontalAlignment="Center" Visibility="{x:Bind Model.ShowPsuComparison, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                        <Button x:Name="ResetPeakButton" Content="Reset peaks" HorizontalAlignment="Right" Click="ResetPeak_Click" ToolTipService.ToolTip="Reset peak hold"
                            Visibility="{x:Bind Model.ShowPeakHold, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="DetailsColumn" Grid.Row="1" Spacing="14" VerticalAlignment="Top">
                    <Border x:Name="DetailsCard" Style="{StaticResource MonitorCard}">
                        <StackPanel x:Name="GpuStatusHost" />
                    </Border>
                    <Border x:Name="NativeDetailsCard" Style="{StaticResource MonitorCard}">
                        <StackPanel Spacing="14">
                            <StackPanel x:Name="NativeStatusHeading" Orientation="Horizontal" Spacing="9">
                                <controls:WidgetIcon IconName="vcore" Width="28" Height="28" />
                                <TextBlock Text="{x:Bind DetailsHeading}" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="MetricsHost" Spacing="8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
