<ContentDialog x:Class="Rtx5090Monitoring.App.Views.Dialogs.SourceSelectionsHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Source selections" CloseButtonText="Close" DefaultButton="Close">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,12,0">
            <TextBlock Text="GPU status profiles" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Profiles select connector Power, Total current and Voltage independently. The backend resolves them once, and GPU status in the desktop app and widget displays those selections. Original plugin readings and pin charts stay separate. GPU board power is never substituted." TextWrapping="Wrap" />
            <TextBlock Text="Example: choose your preferred power reading" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Automatic prefers Nvidia connector power and current, then ROG Astral, then WireView. MSI connector current is the last current fallback. Voltage prefers Astral, WireView and then Nvidia. Only sources that supply the requested connector metric can win." TextWrapping="Wrap" />
            <TextBlock Text="Fallback and recovery" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="With fallback enabled, the next source is used when the preferred reading is missing, disabled, stale or invalid. When the preferred source recovers, it wins again. With fallback off, only the first source is used. The WireView profile starts with fallback off for all three values." TextWrapping="Wrap" />
            <TextBlock Text="MSI connector association" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Automatic uses the connector with nonzero pin currents when the other connector reads zero. At idle, a known connector is retained. If both connectors carry current, select Connector 1 or Connector 2 manually. If neither has ever carried current, the source remains unavailable. MSI supplies current, not connector power or voltage." TextWrapping="Wrap" />
            <TextBlock Text="Apply changes" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Choose a profile, reorder its sources or change fallback, then Apply changes. Changes apply live to every consumer. User edits are preserved across restarts. External monitors must be associated with the selected GPU's cable." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
