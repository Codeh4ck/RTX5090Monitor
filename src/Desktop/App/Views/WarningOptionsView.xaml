<UserControl x:Class="RTXLens.App.Views.WarningOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:warnings="using:RTXLens.Contracts.Warnings"
    xmlns:controls="using:RTXLens.App.Controls">
    <StackPanel Spacing="14">
        <controls:SectionPanel x:Name="NvidiaTemperaturePanel" Header="NVIDIA GPU temperature warnings"
            x:Load="{x:Bind Editor.HasNvidiaWarnings, Mode=OneWay}">
            <ContentControl IsEnabled="{x:Bind Editor.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <StackPanel Spacing="8">
                        <CheckBox Content="Core temperature warning" IsChecked="{x:Bind Editor.NvidiaWarnings.CoreWarningEnabled, Mode=TwoWay}" />
                        <NumberBox Header="Core warning threshold (°C)" Value="{x:Bind Editor.NvidiaWarnings.CoreTemperatureWarningC, Mode=TwoWay}"
                            IsEnabled="{x:Bind Editor.NvidiaWarnings.CoreWarningEnabled, Mode=OneWay}" Minimum="30" Maximum="120" SmallChange="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <CheckBox Content="VRAM temperature warning" IsChecked="{x:Bind Editor.NvidiaWarnings.MemoryWarningEnabled, Mode=TwoWay}" />
                        <NumberBox Header="VRAM warning threshold (°C)" Value="{x:Bind Editor.NvidiaWarnings.MemoryTemperatureWarningC, Mode=TwoWay}"
                            IsEnabled="{x:Bind Editor.NvidiaWarnings.MemoryWarningEnabled, Mode=OneWay}" Minimum="30" Maximum="120" SmallChange="1" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </controls:SectionPanel>
        <controls:SectionPanel Header="Warning notifications">
            <controls:SectionPanel.HeaderActions>
                <Button x:Name="WarningInfoButton" Click="Info_Click" Padding="6" ToolTipService.ToolTip="How warning notifications work"
                    AutomationProperties.Name="How warning notifications work">
                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                </Button>
            </controls:SectionPanel.HeaderActions>
            <ContentControl IsEnabled="{x:Bind Editor.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <ToggleSwitch Header="Enable warning notifications for all consumers" IsOn="{x:Bind Model.NotificationsEnabled, Mode=TwoWay}" />
                    <TextBlock Text="The service controls warning episodes and reminder timing for the desktop and widget. Apply changes to update the live policy. Windows notifications can also be muted for this PC under Settings."
                        Style="{StaticResource MonitorCaption}" />
                    <ContentControl x:Name="DefaultsHost" HorizontalContentAlignment="Stretch" />
                </StackPanel>
            </ContentControl>
        </controls:SectionPanel>
        <controls:SectionPanel Header="Per-warning overrides">
            <ContentControl IsEnabled="{x:Bind Editor.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <ComboBox x:Name="WarningPicker" Header="Warning type" ItemsSource="{x:Bind Model.Overrides}" DisplayMemberPath="Name"
                        SelectionChanged="Warning_Changed" HorizontalAlignment="Stretch" />
                    <ContentControl x:Name="OverrideHost" HorizontalContentAlignment="Stretch" />
                    <TextBlock Text="The service builds this list from installed plugin definitions, including disabled plugins. If the list is empty, update the backend service or install a plugin that declares warnings."
                        Style="{StaticResource MonitorCaption}" />
                </StackPanel>
            </ContentControl>
        </controls:SectionPanel>
        <controls:SectionPanel Header="Current warnings">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind Dashboard.WarningSummary, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
                <ItemsControl ItemsSource="{x:Bind Dashboard.CurrentWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="warnings:WarningState">
                            <Border Style="{StaticResource MonitorCard}" Margin="0,0,0,8" Padding="12">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Phase}" Foreground="{ThemeResource MonitorCaution}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MonitorCaption}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Recovering pauses reminders until the clear duration is confirmed. Unavailable means readings cannot currently establish recovery." Style="{StaticResource MonitorCaption}" />
            </StackPanel>
        </controls:SectionPanel>
    </StackPanel>
</UserControl>
