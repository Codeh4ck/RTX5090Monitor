<UserControl
    x:Class="Rtx5090Monitoring.App.Views.SettingsProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls">
    <controls:SectionPanel Header="GPU chart profiles">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProfilePicker" Header="Profile" DisplayMemberPath="Name" MinWidth="210" SelectionChanged="ProfileChanged" />
                <Button x:Name="UseButton" Content="Use selected profile" VerticalAlignment="Bottom" Click="UseProfile" />
                <Button Content="Refresh" VerticalAlignment="Bottom" Click="Refresh" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
            <ContentControl x:Name="Editor" IsEnabled="False" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Grid x:Name="Fields" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="10" />
                    <TextBox x:Name="ProfileName" Header="Name for saved chart profile" MaxLength="80" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply for this session" Click="ApplySession" />
                        <Button Content="Save as profile" Click="SaveProfile" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </controls:SectionPanel>
</UserControl>
