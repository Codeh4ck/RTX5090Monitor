<Window x:Class="RTXLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telemetry="using:RTXLens.Presentation.Telemetry"
    Title="RTX Lens">
    <Grid x:Name="Root" Background="{ThemeResource MonitorBackground}" Padding="24,12,24,12" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="ApplicationHeader" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" SizeChanged="ApplicationHeader_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Grid Width="8"><Border x:Name="AccentGlow" Background="{ThemeResource MonitorAccent}" CornerRadius="4" Opacity="0.2"/>
                    <Border Width="4" Background="{ThemeResource MonitorAccent}" CornerRadius="2"/></Grid>
                <StackPanel><TextBlock Text="RTX LENS" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource MonitorForeground}"/>
                    <TextBlock x:Name="ModeLabel" Text="POWER · PINS · PROTECTION" Style="{StaticResource MonitorCaption}"/></StackPanel>
            </StackPanel>
            <StackPanel x:Name="WebsiteLinks" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="❤️ Support RTX Lens" Background="{ThemeResource MonitorPanel}" Foreground="{ThemeResource MonitorAccent}"
                    BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="1" Click="Support_Click" />
                <HyperlinkButton Content="Official website" Foreground="{ThemeResource MonitorAccent}" NavigateUri="https://rtxlens.com/" />
                <HyperlinkButton Content="Release notes" Foreground="{ThemeResource MonitorAccent}" Click="ReleaseNotes_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{x:Bind Updates.Summary, Mode=OneWay}" Click="Settings_Click"
                    Visibility="{x:Bind WarningVisibility(Updates.HasUpdates), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Model.Summary, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MonitorCaption}"/>
                <Button x:Name="PluginWarningButton" Background="Transparent" BorderThickness="0" Padding="6" Click="Configuration_Click"
                    Visibility="{x:Bind WarningVisibility(Model.HasPluginWarning), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Model.PluginWarning, Mode=OneWay}" AutomationProperties.Name="Enabled plugins are not reporting. Open configuration.">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource MonitorCaution}" />
                </Button>
            </StackPanel>
        </Grid>
        <Border x:Name="NavigationStrip" Grid.Row="1" Background="{ThemeResource MonitorInset}" BorderBrush="{ThemeResource MonitorBorder}"
            BorderThickness="1" CornerRadius="8" Padding="6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                <ItemsControl x:Name="Tabs" ItemsSource="{x:Bind Model.ReportingPanels}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="telemetry:HardwarePanelViewModel">
                        <ToggleButton Content="{x:Bind Name}" Tag="{x:Bind Id}" IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                            Style="{StaticResource MonitorNavigationTab}" Click="HardwareTab_Click" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                    <ToggleButton x:Name="PerformanceTab" Content="Performance Chart"
                        Style="{StaticResource MonitorNavigationTab}" Click="Performance_Click" />
                </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Configuration" Click="Configuration_Click"/><Button Content="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{ThemeResource MonitorForeground}"/>
        <Grid Grid.Row="3"><TextBlock Text="{x:Bind Model.Connection, Mode=OneWay}" Style="{StaticResource MonitorCaption}" TextTrimming="CharacterEllipsis" Margin="0,0,130,0"/>
            <TextBlock x:Name="OperationStatus" HorizontalAlignment="Right" MaxWidth="360" TextTrimming="CharacterEllipsis" Style="{StaticResource MonitorCaption}" Text="Live monitoring"/></Grid>
    </Grid>
</Window>
