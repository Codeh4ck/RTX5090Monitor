<Window x:Class="Rtx5090Monitoring.App.Debugging.Windows.DebugWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RTX Monitor · Debug Console">
    <Grid x:Name="Root" Background="{ThemeResource MonitorBackground}" Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid.Resources>
            <ResourceDictionary><ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/ConfigurationTabs.xaml" />
            </ResourceDictionary.MergedDictionaries></ResourceDictionary>
        </Grid.Resources>
        <StackPanel Spacing="8">
            <TextBlock Text="DEBUG CONSOLE" Style="{StaticResource MonitorHeading}" />
            <TextBlock Text="Local simulation · real service data stays untouched" Style="{StaticResource MonitorCaption}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource MonitorCard}" Padding="12">
            <StackPanel Spacing="8">
                <ToggleSwitch x:Name="SimulationToggle" Header="Enable simulation" IsOn="{x:Bind Model.Enabled, Mode=TwoWay}" />
                <TextBlock Text="Edits apply immediately. Closing this window stops simulation and restores live service data. Values are session-only."
                    Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TabView x:Name="PluginTabs" Grid.Row="2" Style="{StaticResource MonitorConfigurationTabs}" IsAddTabButtonVisible="False"
            CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" />
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind Model.LastNotification, Mode=OneWay}" Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" MaxHeight="60" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Disable simulation" Click="Disable_Click" />
                <Button Content="Reset all" Click="ResetAll_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
