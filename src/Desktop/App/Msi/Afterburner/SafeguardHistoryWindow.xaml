<Window x:Class="Rtx5090Monitoring.App.Msi.Afterburner.SafeguardHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rtx5090Monitoring.App.Msi.Afterburner"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls"
    Title="RTX Monitor - Safeguard+ History">
    <Grid x:Name="Root" Background="{ThemeResource MonitorBackground}" Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="Safeguard+ History" Style="{StaticResource MonitorHeading}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="InspectButton" Content="Inspect" Click="Inspect_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Content="Delete selected" Click="Delete_Click" IsEnabled="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <NumberBox x:Name="Retention" Header="History retention (days)" Minimum="1" Maximum="365"
                    SmallChange="1" Width="168" SpinButtonPlacementMode="Inline" />
                <Button Content="Save retention" Click="SaveRetention_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="2*,*,*" ColumnSpacing="10" Margin="12,0,16,0">
            <TextBlock Text="Script" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Date/time" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Execution status" FontWeight="SemiBold" />
        </Grid>
        <ListView x:Name="Executions" Grid.Row="3" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False"
            SelectionChanged="Selection_Changed" DoubleTapped="Executions_DoubleTapped" BorderThickness="1"
            BorderBrush="{ThemeResource MonitorBorder}" CornerRadius="6" Padding="0,0,12,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="46" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SafeguardHistoryRow">
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Date}" VerticalAlignment="Center" />
                        <controls:StatusBadge Grid.Column="2" Text="{x:Bind Status}" Tone="{x:Bind Tone}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Message" Grid.Row="4" Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
    </Grid>
</Window>