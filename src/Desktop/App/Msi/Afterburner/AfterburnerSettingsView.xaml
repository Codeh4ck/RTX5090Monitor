<UserControl x:Class="RTXLens.App.Msi.Afterburner.AfterburnerSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:RTXLens.App.Controls" xmlns:local="using:RTXLens.App.Msi.Afterburner">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/ConfigurationTabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AfterburnerStatusBadge" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource MonitorAccent}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style x:Key="AfterburnerStatusValue" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource MonitorForeground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VersionStates">
                <VisualState x:Name="VersionPresent" />
                <VisualState x:Name="VersionMissing">
                    <VisualState.Setters>
                        <Setter Target="VersionBadge.BorderBrush" Value="{ThemeResource MonitorDanger}" />
                        <Setter Target="VersionBadge.Background" Value="{ThemeResource MonitorDangerSurface}" />
                        <Setter Target="VersionStatus.Foreground" Value="{ThemeResource MonitorDanger}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PluginStates">
                <VisualState x:Name="PluginPresent" />
                <VisualState x:Name="PluginMissing">
                    <VisualState.Setters>
                        <Setter Target="PluginBadge.BorderBrush" Value="{ThemeResource MonitorDanger}" />
                        <Setter Target="PluginBadge.Background" Value="{ThemeResource MonitorDangerSurface}" />
                        <Setter Target="PluginStatus.Foreground" Value="{ThemeResource MonitorDanger}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="HeaderLayout" ColumnDefinitions="*,*" ColumnSpacing="14" SizeChanged="PageLayout_Changed">
            <TextBlock Text="Afterburner Safeguard+ Integration" Margin="18,0,0,0" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" Margin="0" ColumnSpacing="12" HorizontalAlignment="Right">
                <Grid x:Name="ProcessWarning" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="" FontSize="18" Foreground="#FFD15C" VerticalAlignment="Center" Width="18" />
                    <TextBlock x:Name="ProcessWarningText" Grid.Column="1" Text="Afterburner is running. Close Afterburner to modify Safeguard+ settings!" Foreground="#FFD15C" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Button Grid.Column="1" Click="Info_Click" Padding="6" ToolTipService.ToolTip="About Afterburner Safeguard+ Integration" AutomationProperties.Name="About Afterburner Safeguard+ Integration" x:Name="HeaderInfoButton">
                    <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                </Button>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" SizeChanged="PageLayout_Changed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Panels" ColumnDefinitions="*,*" ColumnSpacing="14" VerticalAlignment="Top" Margin="0,0,0,8" SizeChanged="PageLayout_Changed">
                <StackPanel x:Name="LeftColumn" Spacing="14" VerticalAlignment="Top">
                    <controls:SectionPanel x:Name="ConfigurationPanel" Header="Afterburner configuration" VerticalAlignment="Top">
                        <StackPanel x:Name="ConfigurationBody" Spacing="14">
                            <Grid x:Name="StatusBadges" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border x:Name="VersionBadge" Style="{StaticResource AfterburnerStatusBadge}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="Afterburner" Foreground="{ThemeResource MonitorMuted}" />
                                        <TextBlock x:Name="VersionStatus" Text="-" Style="{StaticResource AfterburnerStatusValue}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PluginBadge" Grid.Column="1" Style="{StaticResource AfterburnerStatusBadge}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="PSU.dll" Foreground="{ThemeResource MonitorMuted}" />
                                        <TextBlock x:Name="PluginStatus" Text="-" Style="{StaticResource AfterburnerStatusValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ComboBox x:Name="InstallationPicker" Header="Afterburner installation" DisplayMemberPath="Directory" HorizontalAlignment="Stretch" SelectionChanged="Installation_Changed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Locate Afterburner..." Click="Locate_Click" />
                                <Button Content="Refresh status" Click="Refresh_Click" />
                            </StackPanel>
                            <ContentControl x:Name="SettingsPanel" IsEnabled="False" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <CheckBox x:Name="MonitoringEnabled" Content="Enable PSU.dll monitoring in Afterburner" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                        <CheckBox x:Name="SoftwareAlarmsEnabled" Content="Enable Afterburner Safeguard+ alarms" Checked="SoftwareAlarms_Changed" Unchecked="SoftwareAlarms_Changed" />
                                        <Button Grid.Column="1" Click="SoftwareAlarmInfo_Click" Padding="6" ToolTipService.ToolTip="About software alarms" AutomationProperties.Name="About software alarms">
                                            <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ContentControl x:Name="ThresholdsPanel" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <NumberBox x:Name="MaxCurrent" VerticalAlignment="Bottom" Header="Max per-pin current (A)" Minimum="0.1" Maximum="30" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="CurrentValue_Changed" />
                                                <NumberBox x:Name="CurrentDifference" Grid.Column="1" VerticalAlignment="Bottom" Header="Max pin current difference (A)" Minimum="0.1" Maximum="30" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="CurrentValue_Changed" />
                                            </Grid>
                                        </ContentControl>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ThresholdInfo_Click" Padding="6" ToolTipService.ToolTip="About current thresholds" AutomationProperties.Name="About current thresholds">
                                            <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </controls:SectionPanel>
                    <controls:SectionPanel x:Name="ConnectorConfigurationPanel" Header="Connector configuration" VerticalAlignment="Top">
                        <ContentControl x:Name="ConnectorSettingsPanel" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <TabView x:Name="ConnectorConfigurationTabs" Style="{StaticResource MonitorConfigurationTabs}" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
                                <TabViewItem Header="Connector 1" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                                    <ContentControl x:Name="Connector1Host" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" />
                                </TabViewItem>
                                <TabViewItem Header="Connector 2" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                                    <ContentControl x:Name="Connector2Host" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" />
                                </TabViewItem>
                            </TabView>
                        </ContentControl>
                    </controls:SectionPanel>
                </StackPanel>
                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="14" VerticalAlignment="Top">
                    <controls:SectionPanel x:Name="BackupsPanel" Header="Configuration backups" VerticalAlignment="Top">
                        <controls:SectionPanel.HeaderActions>
                            <Button Click="BackupInfo_Click" Padding="6" ToolTipService.ToolTip="About configuration backups" AutomationProperties.Name="About configuration backups">
                                <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                            </Button>
                        </controls:SectionPanel.HeaderActions>
                        <StackPanel Spacing="12">
                            <StackPanel x:Name="BackupActions" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveButton" Content="Save config" Click="Save_Click" IsEnabled="False" />
                                <Button x:Name="RestoreButton" Content="Restore config" Click="Restore_Click" IsEnabled="False" />
                                <Button x:Name="DeleteBackupButton" Content="Delete" Click="DeleteBackup_Click" IsEnabled="False" Foreground="{ThemeResource MonitorDanger}" />
                            </StackPanel>
                            <Grid x:Name="BackupColumnHeaders" ColumnDefinitions="180,*" Margin="6,0,24,0" ColumnSpacing="12">
                                <TextBlock Text="Datetime" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                            </Grid>
                            <ListView x:Name="BackupPicker" MaxHeight="290" Padding="0" SelectionMode="Multiple" SelectionChanged="Backup_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="1" CornerRadius="6" Height="290" IsMultiSelectCheckBoxEnabled="False" ToolTipService.ToolTip="Select one backup to restore, or multiple backups to delete together.">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,8,24,8" />
                                        <Setter Property="Height" Value="48" />
                                        <Setter Property="MinHeight" Value="48" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AfterburnerBackupChoice">
                                        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                                            <TextBlock Text="{x:Bind DateTimeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DateTimeText}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <HyperlinkButton x:Name="BackupLocation" Click="BackupLocation_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" ToolTipService.ToolTip="Open backup folder in Explorer" />
                        </StackPanel>
                    </controls:SectionPanel>
                    <Grid x:Name="ActionButtons" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button x:Name="ApplyButton" Content="Apply Afterburner settings..." Click="Apply_Click" IsEnabled="False" />
                        <Button x:Name="RestartButton" Grid.Column="2" Content="Restart Afterburner" Style="{StaticResource AccentButtonStyle}" Click="Restart_Click" IsEnabled="False" />
                    </Grid>
                    <InfoBar x:Name="OperationMessage" IsOpen="False" Severity="Informational">
                        <InfoBar.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#143F2B" />
                                        <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#64E5A7" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#DDF5E7" />
                                        <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#14734A" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </InfoBar.Resources>
                    </InfoBar>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>