<Window x:Class="Rtx5090Monitoring.App.Msi.Windows.MsiFanCurveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:configuration="using:Rtx5090Monitoring.Presentation.Configuration"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls"
    Title="RTX Monitor - MSI PSU fan curve">
    <Grid x:Name="Root" Background="{ThemeResource MonitorBackground}" Padding="20" RowDefinitions="Auto,*" RowSpacing="14">
        <StackPanel x:Name="HeaderPanel" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:WidgetIcon IconName="vfan" Width="30" Height="30" />
                <TextBlock Text="MSI PSU fan curve" Style="{StaticResource MonitorHeading}" />
            </StackPanel>
            <TextBlock Text="The backend service runs the applied curve, including while this window and the desktop app are closed."
                Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <Grid x:Name="EditorLayout" VerticalAlignment="Top" ColumnDefinitions="*,330" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="0">
                <StackPanel x:Name="GraphColumn" Spacing="12" VerticalAlignment="Top">
                    <Border x:Name="GraphPanel" Style="{StaticResource MonitorCard}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Temperature / fan duty" Style="{StaticResource MonitorSectionHeading}" />
                            <StackPanel x:Name="LiveMetrics" Orientation="Horizontal" Spacing="8">
                                <Border x:Name="TemperatureBadge" BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="1" CornerRadius="5" Padding="8" MinWidth="105">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="Temp." Foreground="{ThemeResource MonitorMuted}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TemperatureValue" Text="-" FontWeight="SemiBold" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="FanRpmBadge" BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="1" CornerRadius="5" Padding="8" MinWidth="150">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="Fan RPM" Foreground="{ThemeResource MonitorMuted}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FanRpmValue" Text="-" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RequestedDutyBadge" BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="1" CornerRadius="5" Padding="8" MinWidth="135">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="Requested" Foreground="{ThemeResource MonitorMuted}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RequestedDutyValue" Text="-" FontWeight="SemiBold" MinWidth="35" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LiveStatus" Text="Waiting for live PSU readings..." Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
                            <InfoBar x:Name="ControllerWarning" IsOpen="False" IsClosable="False" Severity="Warning" />
                            <ContentControl x:Name="GraphHost" HorizontalContentAlignment="Stretch" />
                            <TextBlock Text="● PSU duty readback    ○ Requested duty    | Current temperature" Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
                            <TextBlock Text="Double-click to add a point." Style="{StaticResource MonitorCaption}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AutomaticControlNotice" Text="On failure the service attempts Automatic. Hard crashes or USB loss can prevent restoration. Avoid other fan controllers."
                        Style="{StaticResource MonitorCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="OptionsPanel" Grid.Column="1" Spacing="14">
                    <controls:SectionPanel x:Name="FanControlPanel" Header="Fan control">
                        <NumberBox Header="Fan response delay (seconds)" Value="{x:Bind Model.ResponseDelaySeconds, Mode=TwoWay}"
                            Minimum="0" Maximum="60" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="IntegerValue_Changed" />
                    </controls:SectionPanel>
                    <controls:SectionPanel x:Name="CurvePointsPanel" Header="Curve points">
                        <controls:SectionPanel.HeaderActions>
                            <Button Content="Add point" Click="AddPoint_Click" IsEnabled="{x:Bind Model.CanAddCurvePoint, Mode=OneWay}" />
                        </controls:SectionPanel.HeaderActions>
                        <ItemsControl ItemsSource="{x:Bind Model.CurvePoints, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="configuration:MsiFanCurvePointViewModel">
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                                        <NumberBox Header="Temp (°C)" Value="{x:Bind TemperatureC, Mode=TwoWay}" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="IntegerValue_Changed" />
                                        <NumberBox Grid.Column="1" Header="Duty (%)" Tag="FanDuty" Value="{x:Bind DutyPercent, Mode=TwoWay}" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="IntegerValue_Changed" />
                                        <Button Grid.Column="2" Content="×" Tag="{x:Bind}" Click="RemovePoint_Click"
                                            AutomationProperties.Name="Remove curve point" ToolTipService.ToolTip="Remove point" VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SectionPanel>
                    <InfoBar x:Name="EditorError" IsOpen="False" IsClosable="True" Severity="Error" />
                    <Grid x:Name="Actions" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Content="Apply" Click="Apply_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Revert / reload" Click="Reload_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="RestoreDefaultsButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Restore defaults" Click="RestoreDefaults_Click" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
