{
  "Plugins": {
    "msi-psu": {
      "Enabled": true,
      "PollIntervalMs": 1000,
      "StaleAfterMs": 5000,
      "Options": {
        "DevicePath": null,
        "FanControl": "Unmanaged",
        "FanDutyPercent": 50
      }
    },
    "asus-astral": {
      "Enabled": true,
      "PollIntervalMs": 1000,
      "StaleAfterMs": 5000,
      "Options": {
        "DeviceId": null,
        "CoreTemperatureWarningC": 84,
        "MemoryTemperatureWarningC": 95,
        "ImbalanceAmperageThreshold": 6,
        "ImbalancePercentageThreshold": 30,
        "ImbalanceDurationThresholdMs": 3000,
        "WireOvercurrentAmperageThreshold": 9.2,
        "WireOvercurrentThresholdMs": 3000
      }
    },
    "wireview-pro2": {
      "Enabled": true,
      "PollIntervalMs": 1000,
      "StaleAfterMs": 5000
    }
  },
  "Monitoring": {
    "StreamIntervalMs": 1000,
    "Selections": []
  },
  "Warnings": {
    "NotificationsEnabled": true,
    "Defaults": {
      "NotifyOnStart": true,
      "RepeatWhileActive": false,
      "RepeatIntervalSeconds": 5,
      "ClearAfterSeconds": 2
    },
    "Overrides": {}
  }
}
