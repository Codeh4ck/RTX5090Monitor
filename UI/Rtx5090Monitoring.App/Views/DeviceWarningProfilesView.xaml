<UserControl
    x:Class="Rtx5090Monitoring.App.Views.DeviceWarningProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls">
    <controls:SectionPanel Header="Device warning profiles">
        <StackPanel Spacing="12">
            <TextBlock Text="Each enabled profile monitors its own source. WireView firmware alerts still report independently."
                TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="Profiles" AutomationProperties.Name="Warning profile" MinWidth="220" SelectionChanged="ProfileChanged" />
                <Button x:Name="AddButton" Content="New profile" Click="Add_Click" />
                <Button Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
            <ContentControl x:Name="Editor" IsEnabled="False" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBox x:Name="ProfileName" Header="Profile name" MaxLength="80" />
                        <CheckBox Grid.Column="1" x:Name="Enabled" Content="Profile enabled" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
                        <ComboBox x:Name="Source" Header="Reading source"
                            HorizontalAlignment="Stretch" SelectionChanged="SourceChanged" />
                        <ComboBox Grid.Column="1" x:Name="Device" Header="Device"
                            HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="2" x:Name="Connector" Header="PSU connector" MinWidth="120">
                            <x:String>Connector 1</x:String>
                            <x:String>Connector 2</x:String>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="UseDefaults" Content="Use detected GPU defaults" Checked="DefaultsChanged" Unchecked="DefaultsChanged" />
                    <Grid x:Name="Limits" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                        <NumberBox x:Name="Overcurrent" Header="Per-pin overcurrent (A)" />
                        <NumberBox Grid.Column="1" x:Name="OvercurrentDuration" Header="Overcurrent duration (ms)" />
                        <NumberBox Grid.Row="1" x:Name="Activation" Header="Highest pin to check imbalance (A)" />
                        <NumberBox Grid.Row="1" Grid.Column="1" x:Name="Imbalance" Header="Current imbalance (%)" />
                        <NumberBox Grid.Row="2" x:Name="ImbalanceDuration" Header="Imbalance duration (ms)" />
                        <NumberBox Grid.Row="3" x:Name="LowVoltage" Header="Low pin voltage (V)" />
                        <NumberBox Grid.Row="3" Grid.Column="1" x:Name="HighVoltage" Header="High pin voltage (V)" />
                    </Grid>
                    <Expander Header="Notifications and shutdown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <CheckBox x:Name="OverridePolicy" Content="Customize notifications for this profile"
                                Checked="OptionsChanged" Unchecked="OptionsChanged" />
                            <ContentControl x:Name="PolicyHost" HorizontalContentAlignment="Stretch" />
                            <CheckBox x:Name="Shutdown" Content="Shut down Windows if a warning persists"
                                Checked="OptionsChanged" Unchecked="OptionsChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="Minutes" Header="Minutes" Width="120" Minimum="0" Maximum="1439" />
                                <NumberBox x:Name="Seconds" Header="Seconds" Width="120" Minimum="0" Maximum="59" />
                            </StackPanel>
                            <TextBlock Text="The countdown starts when a software warning triggers. It resets when that warning clears or its readings become unavailable."
                                TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save warning profile" Click="Save_Click" />
                        <Button x:Name="DeleteButton" Content="Delete profile" Click="Delete_Click" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </controls:SectionPanel>
</UserControl>
