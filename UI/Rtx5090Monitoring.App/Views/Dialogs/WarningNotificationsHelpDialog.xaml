<ContentDialog x:Class="Rtx5090Monitoring.App.Views.Dialogs.WarningNotificationsHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Warning notifications" CloseButtonText="Close" DefaultButton="Close">
    <ScrollViewer MaxHeight="620" Padding="0,0,16,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock Text="Initial notifications and reminders" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Notify when a warning starts sends one initial notification. Repeat while active sends reminders at the selected interval, even when the reading stays unchanged. The default interval is 5 seconds; repetition is off by default." TextWrapping="Wrap" />
            <TextBlock Text="Example: 80°C threshold, 5-second reminders" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="81°C starts the warning and sends its initial notification. A change to 82°C one second later only updates the details. Five seconds after the last notification, another reminder uses the latest reading. Changing readings or pin combinations does not restart or accelerate the timer." TextWrapping="Wrap" />
            <TextBlock Text="Recovery and unavailable data" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Recovery confirmation requires the condition to remain clear for the selected duration. A brief dip stays in the same episode. Reminders pause while recovery is being confirmed. Missing or stale readings pause reminders and show data unavailable; they do not establish recovery. After confirmed recovery, a new occurrence can notify immediately." TextWrapping="Wrap" />
            <TextBlock Text="Independent switches" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="If initial notifications are off and repetition is on, the first reminder occurs after the selected interval. If both are off, the warning remains visible without notifications. Re-enabling global notifications announces active warnings whose initial notifications are enabled. Apply changes updates the service without a restart." TextWrapping="Wrap" />
            <TextBlock Text="Shared policy and per-warning overrides" Style="{StaticResource MonitorSectionHeading}" />
            <TextBlock Text="Installed plugins declare the warning types shown here. Global defaults apply to every supported warning. Detection thresholds are configured in each plugin tab. Select a warning type and turn off Use global defaults to override its initial notification, repetition and recovery settings. Simultaneous notifications are combined. The desktop and widget consume the same service warning states and reminder sequence. Windows notifications also require the local notification switch and a running desktop app. No recovery notification or automatic shutdown is added." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
