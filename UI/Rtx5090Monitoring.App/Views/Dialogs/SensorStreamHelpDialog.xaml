<ContentDialog
    x:Class="Rtx5090Monitoring.App.Views.Dialogs.SensorStreamHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sensor stream" CloseButtonText="Close" DefaultButton="Close">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Padding="0,0,12,0">
            <TextBlock Text="What it does" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="The Sensor stream sends the latest available readings from the service to connected desktop apps and widgets. Its interval controls publication frequency for every connected consumer." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="Polling and publication are separate" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="Each plugin&#x27;s polling interval controls how often hardware is read. The Sensor stream interval controls how often the latest readings are sent. It does not change polling, protection thresholds or the backend alert timers." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="Example: lower update traffic" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="With hardware polling every 500 ms and the Sensor stream every 1000 ms, the service reads twice per second but sends the latest snapshot once per second. Intermediate samples are not a history feed." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="Example: a faster stream" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="With hardware polling every 1000 ms and the Sensor stream every 250 ms, a reading can appear in several snapshots before the next hardware measurement. Sending more often does not create newer measurements." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="When to change it" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="Use a shorter interval for quicker display updates, provided polling is also frequent enough. Use a longer interval to reduce update traffic and client processing. Apply changes to update the live service and all connected consumers; no restart is required." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
