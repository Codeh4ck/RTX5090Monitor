<ContentDialog
    x:Class="Rtx5090Monitoring.App.Views.Dialogs.BackendRestartHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Restart backend service" CloseButtonText="Close" DefaultButton="Close">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Padding="0,0,12,0">
            <TextBlock Text="What restarts" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="This restarts the RTX Monitor backend Windows service and all enabled plugins. Disabled plugins stay disabled. Saved configuration is retained." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="What you will notice" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="Telemetry and backend alert evaluation pause while the service restarts. Connected apps and widgets temporarily lose their streams and reconnect when the backend returns. Sensors are read again as the plugins start." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="When to use it" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="Use this when multiple plugins or the Sensor stream remain unresponsive, or when restarting an individual plugin did not resolve a problem. If only one device is affected, try Restart plugin in its hardware panel first." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="Settings normally apply live" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="Enabling plugins, changing polling intervals and editing source selections do not normally require a restart. This action does not apply your unsaved draft. Apply or discard pending changes first." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <TextBlock Text="Requires the installed Windows service" Style="{StaticResource MonitorSectionHeading}" Margin="0,8,0,0" />
            <TextBlock Text="The request stops the backend process; its configured Windows service recovery policy starts it again. A backend launched manually in a console must be started again manually. If the backend cannot receive requests, use Windows Services to restart it instead." TextWrapping="Wrap" FontSize="14" LineHeight="21" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
