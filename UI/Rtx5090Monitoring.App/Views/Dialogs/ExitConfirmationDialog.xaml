<ContentDialog x:Class="Rtx5090Monitoring.App.Views.Dialogs.ExitConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Close RTX Monitor?"
    PrimaryButtonText="Close app"
    CloseButtonText="Cancel"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock Text="Are you sure you want to close the desktop app?" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="Desktop Windows notifications will stop. Any active Performance Chart recording will stop, and recordings you have not exported will be lost. Unsaved configuration and fan curve edits will be discarded."
                TextWrapping="Wrap" Foreground="{ThemeResource MonitorWarning}" />
            <TextBlock Text="The backend service will continue monitoring, evaluating warnings, running MSI fan curves and handling configured warning shutdowns. Widgets will continue receiving data while the backend is running."
                TextWrapping="Wrap" />
            <TextBlock Text="To keep desktop notifications and recordings active, cancel and minimize the app to the system tray instead."
                TextWrapping="Wrap" />
            <CheckBox x:Name="DoNotShowAgain" Content="Do not show this again" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
