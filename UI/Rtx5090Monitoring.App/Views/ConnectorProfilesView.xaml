<UserControl x:Class="Rtx5090Monitoring.App.Views.ConnectorProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="14">
        <TextBlock Text="These profiles select the connector Power, Total current and Voltage shown in GPU status, in both the desktop app and widget. GPU board power is never used."
            Style="{StaticResource MonitorCaption}" />
        <ComboBox Header="Active GPU status profile" ItemsSource="{x:Bind Model.Profiles}" DisplayMemberPath="Name"
            SelectedItem="{x:Bind Model.SelectedProfile, Mode=TwoWay}" SelectionChanged="Profile_Changed" HorizontalAlignment="Stretch" />
        <StackPanel x:Name="ProfileHost" Spacing="14" />
    </StackPanel>
</UserControl>
