<UserControl
    x:Class="Rtx5090Monitoring.App.Views.PerformanceChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Performance Chart" Style="{StaticResource MonitorHeading}" />
                <TextBlock x:Name="SessionStatus" TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
            </StackPanel>
            <Grid x:Name="SessionActions" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto"
                RowDefinitions="Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start recording" Click="Start_Click" />
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop recording" Click="Stop_Click" IsEnabled="False" />
                <Button x:Name="ImportButton" Grid.Column="2" Content="Import recording" Click="Import_Click" />
                <Button x:Name="ExportButton" Grid.Column="3" Content="Export recording" Click="Export_Click" IsEnabled="False" />
            </Grid>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Warning" />
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourcesColumn" Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MonitorCard}" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Metrics and sources" Style="{StaticResource MonitorSectionHeading}" />
                        <TextBlock x:Name="EmptySources" Text="Waiting for supported sensor readings." Style="{StaticResource MonitorCaption}" />
                    </StackPanel>
                    <ScrollViewer x:Name="SourcesScroll" Grid.Row="1" Padding="0,0,20,0"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <StackPanel x:Name="SourcesHost" Spacing="10" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MonitorCard}" Padding="0">
                <WebView2 x:Name="Chart" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
