<UserControl
    x:Class="Rtx5090Monitoring.App.Views.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls"
    xmlns:converters="using:Rtx5090Monitoring.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ConfigurationTabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,Auto" Padding="12,12" RowSpacing="14">
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind Model.Title}" Style="{StaticResource MonitorHeading}" />
            <TextBlock Text="{x:Bind Model.RevisionText, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
            <TextBlock Text="{x:Bind Model.Message, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource MonitorCaption}" />
        </StackPanel>
        <TabView x:Name="ConfigurationTabs" Grid.Row="1" Style="{StaticResource MonitorConfigurationTabs}" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False"
            CanDragTabs="False" CanReorderTabs="False"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{ThemeResource MonitorBackground}">
            <TabViewItem x:Name="StreamTab" Header="Sensor stream" Tag="stream" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                <ScrollViewer Padding="0,16,0,8" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                    <controls:SectionPanel x:Name="StreamPanel" Header="Sensor stream" VerticalAlignment="Top">
                        <controls:SectionPanel.HeaderActions>
                            <Button x:Name="SensorStreamInfoButton" Click="SensorStreamInfo_Click" Padding="6"
                                ToolTipService.ToolTip="About Sensor stream" AutomationProperties.Name="About Sensor stream">
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                            </Button>
                        </controls:SectionPanel.HeaderActions>
                        <StackPanel Spacing="12">
                            <NumberBox Header="Sensor stream interval (ms)" Value="{x:Bind Model.StreamIntervalMs, Mode=TwoWay}"
                                IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
                                Minimum="100" Maximum="30000" SmallChange="100" SpinButtonPlacementMode="Inline" />
                            <TextBlock Text="Sets how often the service publishes the latest readings to all connected apps and widgets. Hardware polling is configured separately in each plugin's tab." Style="{StaticResource MonitorCaption}" />
                        </StackPanel>
                    </controls:SectionPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Warnings" Tag="warnings" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                <ScrollViewer Padding="0,16,16,8" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                    <ContentControl x:Name="WarningsHost" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Source selections" Tag="sources" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                <ScrollViewer Padding="0,16,0,8" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                    <controls:SectionPanel x:Name="SourcesPanel" Header="Source selections" VerticalAlignment="Top">
                        <controls:SectionPanel.HeaderActions>
                            <Button x:Name="SourceSelectionsInfoButton" Click="SourceSelectionsInfo_Click" Padding="6"
                                ToolTipService.ToolTip="About Source selections" AutomationProperties.Name="About Source selections">
                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                            </Button>
                        </controls:SectionPanel.HeaderActions>
                        <StackPanel Spacing="14">
                            <ContentControl IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <ContentControl x:Name="ProfilesHost" HorizontalContentAlignment="Stretch" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </controls:SectionPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Maintenance" Tag="maintenance" IsClosable="False" Style="{StaticResource MonitorConfigurationTab}">
                <ScrollViewer Padding="0,16,0,8" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                    <Expander x:Name="MaintenancePanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                        Background="{ThemeResource MonitorPanel}" BorderBrush="{ThemeResource MonitorBorder}" CornerRadius="8" Padding="18">
                        <Expander.Header><TextBlock Text="Backend maintenance" Style="{StaticResource MonitorSectionHeading}" /></Expander.Header>
                        <StackPanel x:Name="MaintenanceActions" Spacing="10">
                            <TextBlock Text="Restart the backend service and all enabled plugins. To restart one plugin, use Restart plugin in its hardware panel." Style="{StaticResource MonitorCaption}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RestartBackendServiceButton" Content="Restart backend service" Click="RestartService_Click" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" />
                                <Button x:Name="BackendRestartInfoButton" Click="BackendRestartInfo_Click" Padding="6"
                                    ToolTipService.ToolTip="About Restart backend service" AutomationProperties.Name="About Restart backend service">
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource MonitorAccent}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        <Border x:Name="EditFooter" Grid.Row="2" Visibility="{x:Bind Model.IsDirty, Mode=OneWay, Converter={StaticResource BoolVisibility}}"
            Background="{ThemeResource MonitorPanel}" BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Spacing="10">
                <TextBlock Text="Unsaved configuration changes" FontWeight="SemiBold" />
                <TextBlock x:Name="ConflictText" Text="Configuration changed elsewhere. Reload before applying." Foreground="{ThemeResource MonitorWarning}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Apply changes" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" Click="Apply_Click" />
                    <Button Content="Reload / discard draft" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" Click="Reload_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
