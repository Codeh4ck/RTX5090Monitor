<UserControl x:Class="Rtx5090Monitoring.App.Views.ConnectorMetricEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource MonitorCard}">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind Model.Label}" Style="{StaticResource MonitorSectionHeading}" />
            <CheckBox Content="Fall back when a preferred connector source is unavailable" IsChecked="{x:Bind Model.AllowFallback, Mode=TwoWay}" />
            <TextBlock Text="Priority order - the first usable source wins. With fallback off, only the first source is used." Style="{StaticResource MonitorCaption}" />
            <ListView ItemsSource="{x:Bind Model.Sources}" DisplayMemberPath="Label" SelectedItem="{x:Bind Model.SelectedSource, Mode=TwoWay}" MaxHeight="210" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Move up" Click="Up_Click" />
                <Button Content="Move down" Click="Down_Click" />
                <Button Content="Remove" Click="Remove_Click" />
            </StackPanel>
            <ComboBox Header="Add connector source" ItemsSource="{x:Bind Model.AvailableSources}" DisplayMemberPath="Label"
                SelectedItem="{x:Bind Model.Candidate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <Button Content="Add source" Click="Add_Click" />
            <TextBlock Text="{x:Bind Model.Resolution, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
        </StackPanel>
    </Border>
</UserControl>
