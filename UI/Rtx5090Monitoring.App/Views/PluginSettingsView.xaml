<UserControl
    x:Class="Rtx5090Monitoring.App.Views.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls"
    xmlns:converters="using:Rtx5090Monitoring.App.Converters">
    <UserControl.Resources><converters:BooleanVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
    <StackPanel Spacing="14">
        <controls:SectionPanel Header="{x:Bind Model.Name}">
            <controls:SectionPanel.HeaderActions>
                <CheckBox Content="Enabled" IsChecked="{x:Bind Model.Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
            </controls:SectionPanel.HeaderActions>
            <StackPanel Spacing="14">
                <TextBlock Text="Updates affect the service and every connected consumer." Style="{StaticResource MonitorCaption}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <NumberBox Header="Polling interval (ms)" Value="{x:Bind Model.PollIntervalMs, Mode=TwoWay}" Minimum="{x:Bind Model.MinimumPollMs}" Maximum="30000" SmallChange="100" SpinButtonPlacementMode="Inline" />
                    <NumberBox Grid.Column="1" Header="Stale after (ms)" Value="{x:Bind Model.StaleAfterMs, Mode=TwoWay}" Minimum="100" Maximum="300000" SmallChange="100" SpinButtonPlacementMode="Inline" />
                </Grid>
                <StackPanel Spacing="12" Visibility="{x:Bind Model.IsAsus, Converter={StaticResource BoolVisibility}}">
                    <ComboBox Header="Selected GPU" ItemsSource="{x:Bind Model.Asus.Devices}" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind Model.Asus.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Button Content="Refresh GPU list" Click="RefreshDevices_Click" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <NumberBox Header="Imbalance activation (A)" Value="{x:Bind Model.Asus.ImbalanceActivationA, Mode=TwoWay}" Minimum="1" Maximum="10" SmallChange="1" />
                        <NumberBox Grid.Column="1" Header="Imbalance threshold (%)" Value="{x:Bind Model.Asus.ImbalancePercentage, Mode=TwoWay}" Minimum="10" Maximum="50" SmallChange="1" />
                    </Grid>
                    <NumberBox Header="Imbalance duration (ms)" Value="{x:Bind Model.Asus.ImbalanceDurationMs, Mode=TwoWay}" Minimum="100" Maximum="30000" SmallChange="100" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <NumberBox x:Name="OvercurrentInput" Header="Per-pin overcurrent (A)" Value="{x:Bind Model.Asus.OvercurrentA, Mode=TwoWay}" Minimum="6" Maximum="10.5" SmallChange="0.1" />
                        <NumberBox Grid.Column="1" Header="Overcurrent duration (ms)" Value="{x:Bind Model.Asus.OvercurrentDurationMs, Mode=TwoWay}" Minimum="100" Maximum="30000" SmallChange="100" />
                    </Grid>
                    <TextBlock Text="Durations must be at least the polling interval and at most max(polling interval, 10000 ms)." Style="{StaticResource MonitorCaption}" />
                </StackPanel>
                <StackPanel x:Name="NvidiaSettings" Spacing="12" x:Load="{x:Bind Model.IsNvidia}">
                    <CheckBox Content="Show GPU status as a separate tab"
                        IsChecked="{x:Bind Preferences.ShowSeparateGpuStatusTab, Mode=TwoWay}"
                        IsEnabled="{x:Bind Preferences.CanChooseGpuStatusTab, Mode=OneWay}" />
                    <TextBlock Text="Saved for this desktop app. The separate tab is required and cannot be hidden while neither WireView nor ROG Astral is reporting, so GPU status remains accessible."
                        Style="{StaticResource MonitorCaption}" />
                    <ComboBox Header="Selected GPU" ItemsSource="{x:Bind Model.Nvidia.Devices}" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind Model.Nvidia.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Button Content="Refresh GPU list" Click="RefreshNvidiaDevices_Click" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Spacing="8">
                            <CheckBox Content="Core temperature warning" IsChecked="{x:Bind Model.Nvidia.CoreWarningEnabled, Mode=TwoWay}" />
                            <NumberBox Header="Core warning threshold (°C)" Value="{x:Bind Model.Nvidia.CoreTemperatureWarningC, Mode=TwoWay}"
                                IsEnabled="{x:Bind Model.Nvidia.CoreWarningEnabled, Mode=OneWay}" Minimum="30" Maximum="120" SmallChange="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <CheckBox Content="VRAM temperature warning" IsChecked="{x:Bind Model.Nvidia.MemoryWarningEnabled, Mode=TwoWay}" />
                            <NumberBox Header="VRAM warning threshold (°C)" Value="{x:Bind Model.Nvidia.MemoryTemperatureWarningC, Mode=TwoWay}"
                                IsEnabled="{x:Bind Model.Nvidia.MemoryWarningEnabled, Mode=OneWay}" Minimum="30" Maximum="120" SmallChange="1" />
                        </StackPanel>
                    </Grid>
                    <ComboBox Header="GPU status electrical source" SelectedIndex="{x:Bind Model.Nvidia.ElectricalSourceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Automatic - measured GPU connector readings" />
                        <ComboBoxItem Content="WireView - explicitly associate it with the selected GPU" />
                        <ComboBoxItem Content="None" />
                    </ComboBox>
                    <TextBlock Text="Select WireView only when it monitors this GPU. Unsupported readings remain unavailable; current is never estimated from GPU board power. Fans and core voltage are read only."
                        Style="{StaticResource MonitorCaption}" />
                </StackPanel>
                <TextBlock Text="Firmware thresholds and fan configuration can be inspected in the WireView device settings window. Device writes are not supported."
                    Style="{StaticResource MonitorCaption}" Visibility="{x:Bind Model.IsWireView, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Spacing="12" Visibility="{x:Bind Model.IsMsi, Converter={StaticResource BoolVisibility}}">
                    <ComboBox Header="Selected PSU" ItemsSource="{x:Bind Model.Msi.Devices}" DisplayMemberPath="Name"
                        SelectedItem="{x:Bind Model.Msi.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Button Content="Refresh PSU list" Click="RefreshMsiDevices_Click" />
                    <ComboBox Header="Fan control" SelectedIndex="{x:Bind Model.Msi.FanModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Unmanaged · leave existing fan control alone" />
                        <ComboBoxItem Content="Automatic · PSU-controlled cooling" />
                        <ComboBoxItem Content="Manual · fixed duty" />
                    </ComboBox>
                    <NumberBox Header="Manual fan duty (%)" Value="{x:Bind Model.Msi.FanDutyPercent, Mode=TwoWay}"
                        Minimum="0" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Inline" IsEnabled="{x:Bind Model.Msi.IsManual, Mode=OneWay}" />
                    <TextBlock Text="Fan control is applied live. Releasing control or stopping the plugin restores automatic mode. A 0% request does not guarantee 0 RPM. No save-to-flash command is sent."
                        Style="{StaticResource MonitorCaption}" />
                </StackPanel>
            </StackPanel>
        </controls:SectionPanel>
        <controls:SectionPanel x:Name="PsuComparisonPanel" Header="PSU pin comparison" x:Load="{x:Bind Model.IsMsi}">
            <StackPanel Spacing="16">
                <TextBlock Text="These display preferences apply immediately to this app and do not change the service configuration." Style="{StaticResource MonitorCaption}" />
                <TextBlock Text="Show MSI PSU amperage below the matching P1–P6 labels. Values appear only while the PSU is reporting. Select the connector feeding each device; pin numbers follow each source's numbering." Style="{StaticResource MonitorCaption}" TextWrapping="Wrap"/>
                <ToggleSwitch Header="Show MSI current under WireView pins" IsOn="{x:Bind Preferences.ShowWireViewPsuCurrent, Mode=TwoWay}"/>
                <ComboBox Header="WireView · PSU connector" SelectedIndex="{x:Bind Preferences.WireViewPsuConnectorIndex, Mode=TwoWay}" MinWidth="240"
                    IsEnabled="{x:Bind Preferences.ShowWireViewPsuCurrent, Mode=OneWay}">
                    <ComboBoxItem Content="Connector 1"/><ComboBoxItem Content="Connector 2"/>
                </ComboBox>
                <ToggleSwitch Header="Show MSI current under ROG Astral pins" IsOn="{x:Bind Preferences.ShowAsusPsuCurrent, Mode=TwoWay}"/>
                <ComboBox Header="ROG Astral · PSU connector" SelectedIndex="{x:Bind Preferences.AsusPsuConnectorIndex, Mode=TwoWay}" MinWidth="240"
                    IsEnabled="{x:Bind Preferences.ShowAsusPsuCurrent, Mode=OneWay}">
                    <ComboBoxItem Content="Connector 1"/><ComboBoxItem Content="Connector 2"/>
                </ComboBox>
            </StackPanel>
        </controls:SectionPanel>
    </StackPanel>
</UserControl>
