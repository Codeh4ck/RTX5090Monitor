<UserControl x:Class="Rtx5090Monitoring.App.Views.MsiHardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls"
    xmlns:converters="using:Rtx5090Monitoring.App.Converters">
    <UserControl.Resources><converters:BooleanVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="12">
        <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="MSI MPG Ai1300TS / Ai1600TS" Style="{StaticResource MonitorHeading}" />
                    <TextBlock Text="{x:Bind Model.DeviceText, Mode=OneWay}" Style="{StaticResource MonitorCaption}" />
                </StackPanel>
                <StackPanel x:Name="DeviceActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RestartButton" Click="Restart_Click" AutomationProperties.Name="Restart plugin" Visibility="{x:Bind Model.CanRestart, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/refresh.svg" /></Image.Source>
                            </Image>
                            <TextBlock Text="Restart plugin" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetPeaksButton" Click="ResetPeak_Click" AutomationProperties.Name="Reset peaks" Visibility="{x:Bind Model.Msi.ShowPeakHold, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/refresh.svg" /></Image.Source>
                            </Image>
                            <TextBlock Text="Reset peaks" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <controls:StatusBadge Text="{x:Bind Model.State, Mode=OneWay}" Tone="{x:Bind Model.Tone, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Model.Message, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid x:Name="MetricsGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WidgetIcon IconName="vtemp" Width="20" Height="20" />
                            <TextBlock Text="PSU TEMPERATURE" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Model.Msi.Temperature.Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WidgetIcon IconName="vfan" Width="20" Height="20" />
                            <TextBlock Text="PSU FAN" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Model.Msi.FanSpeed.Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WidgetIcon IconName="vfan" Width="20" Height="20" />
                            <TextBlock Text="FAN MODE" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Model.Msi.FanMode.Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MonitorAccentCard}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WidgetIcon IconName="vfan" Width="20" Height="20" />
                            <TextBlock Text="REQUESTED FAN DUTY" Style="{StaticResource MonitorCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Model.Msi.FanDuty.Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ConnectorGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
