<UserControl x:Class="Rtx5090Monitoring.App.Debugging.Views.DebugMetricEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Rtx5090Monitoring.App.Converters">
    <UserControl.Resources><converters:BooleanVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{x:Bind Caption}" FontWeight="SemiBold" Foreground="{ThemeResource MonitorForeground}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Reset" Click="Reset_Click" Padding="8,2" FontSize="11"/>
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <ComboBox SelectedIndex="{x:Bind Model.ModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Metric source">
                <ComboBoxItem Content="Live / Auto"/><ComboBoxItem Content="Fixed value"/><ComboBoxItem Content="Unavailable"/><ComboBoxItem Content="Stale"/>
            </ComboBox>
            <NumberBox x:Name="ValueInput" Grid.Column="1" Value="{x:Bind Model.Value, Mode=TwoWay}" Minimum="{x:Bind Model.Definition.Minimum}"
                Maximum="{x:Bind Model.Definition.Maximum}" IsEnabled="{x:Bind Model.IsValueEditable, Mode=OneWay}" SpinButtonPlacementMode="Compact"
                AutomationProperties.Name="{x:Bind Caption}"/>
            <ToggleSwitch x:Name="BooleanInput" Grid.Column="1" IsOn="{x:Bind Model.BooleanValue, Mode=TwoWay}"
                IsEnabled="{x:Bind Model.IsValueEditable, Mode=OneWay}" AutomationProperties.Name="{x:Bind Caption}"/>
        </Grid>
        <Button x:Name="FaultBitsButton" Content="Fault bits…" IsEnabled="{x:Bind Model.IsValueEditable, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind Model.EffectiveText, Mode=OneWay}" Style="{StaticResource MonitorCaption}" FontSize="11"/>
        <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" Foreground="{ThemeResource MonitorWarning}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
