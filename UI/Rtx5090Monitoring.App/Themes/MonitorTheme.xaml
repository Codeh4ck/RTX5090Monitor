<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MonitorBackground" Color="#F3F6FA" />
            <SolidColorBrush x:Key="MonitorPanel" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MonitorTrack" Color="#E6EDF5" />
            <SolidColorBrush x:Key="MonitorBorder" Color="#D1DCE9" />
            <SolidColorBrush x:Key="MonitorForeground" Color="#172235" />
            <SolidColorBrush x:Key="MonitorMuted" Color="#52647B" />
            <SolidColorBrush x:Key="MonitorAccent" Color="#007F76" />
            <SolidColorBrush x:Key="MonitorWarning" Color="#A92C48" />
            <SolidColorBrush x:Key="MonitorPeak" Color="#713EB5" />
            <SolidColorBrush x:Key="MonitorInset" Color="#F5F8FC" />
            <SolidColorBrush x:Key="MonitorIconSurface" Color="#BEEDE1" />
            <SolidColorBrush x:Key="MonitorSuccess" Color="#14734A" />
            <SolidColorBrush x:Key="MonitorSuccessSurface" Color="#E4F5EB" />
            <SolidColorBrush x:Key="MonitorCaution" Color="#965500" />
            <SolidColorBrush x:Key="MonitorCautionSurface" Color="#FFF1D8" />
            <SolidColorBrush x:Key="MonitorDanger" Color="#B12E48" />
            <SolidColorBrush x:Key="MonitorDangerSurface" Color="#FCE7EC" />
            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="MonitorPanel" />
            <StaticResource x:Key="ExpanderHeaderForeground" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderForegroundPointerOver" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderForegroundPressed" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderHeaderBorderPointerOverBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderHeaderBorderPressedBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderContentBackground" ResourceKey="MonitorPanel" />
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="TabViewItemHeaderBackground" ResourceKey="MonitorInset" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="MonitorMuted" />
            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="MonitorAccent" />
            <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="MonitorForeground" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MonitorBackground" Color="#090E17" />
            <SolidColorBrush x:Key="MonitorPanel" Color="#111927" />
            <SolidColorBrush x:Key="MonitorTrack" Color="#1B273C" />
            <SolidColorBrush x:Key="MonitorBorder" Color="#29384D" />
            <SolidColorBrush x:Key="MonitorForeground" Color="#E6EEFB" />
            <SolidColorBrush x:Key="MonitorMuted" Color="#ABBCD0" />
            <SolidColorBrush x:Key="MonitorAccent" Color="#39EED1" />
            <SolidColorBrush x:Key="MonitorWarning" Color="#FF8095" />
            <SolidColorBrush x:Key="MonitorPeak" Color="#C29BFF" />
            <SolidColorBrush x:Key="MonitorInset" Color="#0C1422" />
            <SolidColorBrush x:Key="MonitorIconSurface" Color="#7DDCC7" />
            <SolidColorBrush x:Key="MonitorSuccess" Color="#64E5A7" />
            <SolidColorBrush x:Key="MonitorSuccessSurface" Color="#143329" />
            <SolidColorBrush x:Key="MonitorCaution" Color="#FFC66D" />
            <SolidColorBrush x:Key="MonitorCautionSurface" Color="#392B17" />
            <SolidColorBrush x:Key="MonitorDanger" Color="#FF819A" />
            <SolidColorBrush x:Key="MonitorDangerSurface" Color="#3A1E2B" />
            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="MonitorPanel" />
            <StaticResource x:Key="ExpanderHeaderForeground" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderForegroundPointerOver" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderForegroundPressed" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderHeaderBorderPointerOverBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderHeaderBorderPressedBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="ExpanderContentBackground" ResourceKey="MonitorPanel" />
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="MonitorBorder" />
            <StaticResource x:Key="TabViewItemHeaderBackground" ResourceKey="MonitorInset" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="MonitorTrack" />
            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="MonitorMuted" />
            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="MonitorAccent" />
            <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="MonitorForeground" />
            <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="MonitorForeground" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="MonitorNavigationTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{ThemeResource MonitorForeground}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TabFrame.Background" Value="{ThemeResource MonitorTrack}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TabFrame.Opacity" Value="0.75" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="TabFrame.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters>
                                    <Setter Target="TabFrame.Background" Value="{ThemeResource MonitorTrack}" />
                                    <Setter Target="TabLabel.Foreground" Value="{ThemeResource MonitorAccent}" />
                                    <Setter Target="SelectionRail.Visibility" Value="Visible" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
                                    <Setter Target="TabFrame.Background" Value="{ThemeResource MonitorTrack}" />
                                    <Setter Target="TabLabel.Foreground" Value="{ThemeResource MonitorAccent}" />
                                    <Setter Target="SelectionRail.Visibility" Value="Visible" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters>
                                    <Setter Target="TabFrame.Background" Value="{ThemeResource MonitorTrack}" />
                                    <Setter Target="TabFrame.Opacity" Value="0.75" />
                                    <Setter Target="TabLabel.Foreground" Value="{ThemeResource MonitorAccent}" />
                                    <Setter Target="SelectionRail.Visibility" Value="Visible" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedDisabled"><VisualState.Setters>
                                    <Setter Target="TabFrame.Background" Value="{ThemeResource MonitorTrack}" />
                                    <Setter Target="TabFrame.Opacity" Value="0.45" />
                                    <Setter Target="TabLabel.Foreground" Value="{ThemeResource MonitorAccent}" />
                                    <Setter Target="SelectionRail.Visibility" Value="Visible" />
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="TabFrame" CornerRadius="6" BorderThickness="0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="TabLabel" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="SelectionRail" Height="2" Background="{ThemeResource MonitorAccent}" VerticalAlignment="Bottom" Margin="16,0" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MonitorCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MonitorPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MonitorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="MonitorCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MonitorMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MonitorHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MonitorForeground}" />
    </Style>
    <Style x:Key="MonitorSectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
