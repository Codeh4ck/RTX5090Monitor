<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishDir Condition="'$(EnableTelemetryDebug)' != 'true'">$(MSBuildProjectDirectory)/../../artifacts/desktop/win-x64/</PublishDir>
        <PublishDir Condition="'$(EnableTelemetryDebug)' == 'true'">$(MSBuildProjectDirectory)/../../artifacts/desktop-debug/win-x64/</PublishDir>
    </PropertyGroup>
</Project>
