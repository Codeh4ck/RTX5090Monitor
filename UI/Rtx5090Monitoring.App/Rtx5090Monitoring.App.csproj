<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/monitor.ico</ApplicationIcon>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <OutputPath Condition="'$(EnableTelemetryDebug)' == 'true'">bin/$(Configuration)-TelemetryDebug/</OutputPath>
        <IntermediateOutputPath Condition="'$(EnableTelemetryDebug)' == 'true'">obj/$(Configuration)-TelemetryDebug/</IntermediateOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <Content Update="Assets/monitor.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Update="Assets/Icons/*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
        <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
        <ProjectReference Include="../Rtx5090Monitoring.Presentation/Rtx5090Monitoring.Presentation.csproj" />
        <ProjectReference Include="../../Rtx5090Monitoring.Plugins.Asus.Contracts/Rtx5090Monitoring.Plugins.Asus.Contracts.csproj" />
        <ProjectReference Include="../../Rtx5090Monitoring.Plugins.WireView.Contracts/Rtx5090Monitoring.Plugins.WireView.Contracts.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableTelemetryDebug)' == 'true'">
        <ProjectReference Include="../Rtx5090Monitoring.Debugging/Rtx5090Monitoring.Debugging.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(EnableTelemetryDebug)' != 'true'">
        <Compile Remove="Debugging/**/*.cs;Demo/**/*.cs;Diagnostics/**/*.cs" />
        <Page Remove="Debugging/**/*.xaml" />
    </ItemGroup>
    <Target Name="IncludeCompiledXamlInPortablePublish" AfterTargets="ComputeFilesToPublish">
        <Error Condition="!Exists('$(OutDir)$(AssemblyName).pri')" Text="The app resource index is missing. Build the WinUI project before publishing." />
        <ItemGroup>
            <CompiledXamlForPublish Include="$(OutDir)**/*.xbf" />
            <CompiledXamlForPublish Remove="$(OutDir)Debugging/**/*.xbf" Condition="'$(EnableTelemetryDebug)' != 'true'" />
            <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri">
                <RelativePath>$(AssemblyName).pri</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <ResolvedFileToPublish Include="@(CompiledXamlForPublish)">
                <RelativePath>%(CompiledXamlForPublish.RecursiveDir)%(CompiledXamlForPublish.Filename)%(CompiledXamlForPublish.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
