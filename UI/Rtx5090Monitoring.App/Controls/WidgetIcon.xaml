<UserControl x:Class="Rtx5090Monitoring.App.Controls.WidgetIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Fault"><VisualState.Setters>
                    <Setter Target="IconSurface.Background" Value="{ThemeResource MonitorDanger}" />
                </VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="IconSurface" Background="{ThemeResource MonitorIconSurface}" CornerRadius="5" Padding="5">
            <Image x:Name="GlyphImage" Stretch="Uniform" />
        </Border>
    </Grid>
</UserControl>
