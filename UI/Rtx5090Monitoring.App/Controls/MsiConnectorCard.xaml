<UserControl x:Class="Rtx5090Monitoring.App.Controls.MsiConnectorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource MonitorCard}" BorderBrush="{ThemeResource MonitorAccent}">
        <StackPanel Spacing="14">
            <TextBlock Text="{x:Bind Model.Name}" Style="{StaticResource MonitorSectionHeading}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Background="{ThemeResource MonitorInset}" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SUM OF PIN CURRENTS" Style="{StaticResource MonitorCaption}" FontSize="10" />
                        <TextBlock Text="{x:Bind Model.Total, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource MonitorInset}" BorderBrush="{ThemeResource MonitorPeak}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="CURRENT SPREAD (Δ)" Style="{StaticResource MonitorCaption}" FontSize="10" Foreground="{ThemeResource MonitorPeak}" />
                        <TextBlock Text="{x:Bind Model.Spread, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="PinHost" ColumnDefinitions="48,*,*,*,*,*,*" />
        </StackPanel>
    </Border>
</UserControl>
