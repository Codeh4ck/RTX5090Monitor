<UserControl
    x:Class="Rtx5090Monitoring.App.Controls.PinBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Rtx5090Monitoring.App.Converters"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls">
    <UserControl.Resources><converters:BooleanVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
    <Grid RowDefinitions="Auto,22,158,26,Auto,16" Margin="2,0" HorizontalAlignment="Stretch">
        <controls:StatusBadge Text="{x:Bind Model.Headroom, Mode=OneWay}" Tone="{x:Bind Model.HeadroomTone, Mode=OneWay}"
            ShowIndicator="False" Margin="0,0,0,6" HorizontalAlignment="Center" Visibility="{x:Bind HeadroomVisibility, Mode=OneWay}" ToolTipService.ToolTip="Current headroom to the configured pin limit" />
        <TextBlock Grid.Row="1" Text="{x:Bind Model.DisplayValue, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
        <Viewbox Grid.Row="2" Width="36" Height="158" Stretch="Fill">
        <Grid Height="190" Width="48" Background="{ThemeResource MonitorTrack}" CornerRadius="4" HorizontalAlignment="Center">
            <Canvas Height="190" Width="48">
                <Rectangle Width="48" Height="{x:Bind Model.BarHeight, Mode=OneWay}" Canvas.Top="{x:Bind Model.BarTop, Mode=OneWay}"
                    RadiusX="3" RadiusY="3" Fill="{ThemeResource MonitorAccent}" />
                <Rectangle Width="48" Height="1" Fill="{ThemeResource MonitorMuted}" Opacity="0.6" Canvas.Top="{x:Bind Model.BaselineTop, Mode=OneWay}" />
                <Rectangle Width="48" Height="2" Fill="{ThemeResource MonitorPeak}" Canvas.Top="{x:Bind Model.PeakTop, Mode=OneWay}"
                    Visibility="{x:Bind PeakVisibility, Mode=OneWay}" />
            </Canvas>
            <Border BorderBrush="{ThemeResource MonitorWarning}" BorderThickness="2" CornerRadius="4"
                Visibility="{x:Bind Model.IsWarning, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        </Viewbox>
        <TextBlock Grid.Row="3" Text="{x:Bind Model.Label}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Border x:Name="PsuCurrentBorder" Grid.Row="4" Background="{ThemeResource MonitorInset}" BorderBrush="{ThemeResource MonitorAccent}" BorderThickness="0,1,0,0" Padding="2,6"
            Visibility="{x:Bind Model.ShowPsuCurrent, Mode=OneWay, Converter={StaticResource BoolVisibility}}" ToolTipService.ToolTip="MSI PSU-side current for this pin number">
            <TextBlock Text="{x:Bind Model.PsuCurrentText, Mode=OneWay}" Foreground="{ThemeResource MonitorAccent}" FontSize="12" FontWeight="SemiBold"
                HorizontalAlignment="Center" AutomationProperties.Name="MSI PSU pin current" />
        </Border>
        <TextBlock Grid.Row="5" Text="!" Foreground="{ThemeResource MonitorWarning}" HorizontalAlignment="Center"
            Visibility="{x:Bind Model.IsWarning, Mode=OneWay, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Pin warning"/>
    </Grid>
</UserControl>
