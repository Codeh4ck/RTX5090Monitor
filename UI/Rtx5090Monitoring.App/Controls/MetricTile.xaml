<UserControl x:Class="Rtx5090Monitoring.App.Controls.MetricTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rtx5090Monitoring.App.Controls">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Positive"><VisualState.Setters>
                    <Setter Target="ValueText.Foreground" Value="{ThemeResource MonitorSuccess}" />
                    <Setter Target="Indicator.Fill" Value="{ThemeResource MonitorSuccess}" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Caution"><VisualState.Setters>
                    <Setter Target="ValueText.Foreground" Value="{ThemeResource MonitorMuted}" />
                    <Setter Target="Indicator.Fill" Value="{ThemeResource MonitorCaution}" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Negative"><VisualState.Setters>
                    <Setter Target="ValueText.Foreground" Value="{ThemeResource MonitorDanger}" />
                    <Setter Target="Indicator.Fill" Value="{ThemeResource MonitorDanger}" />
                    <Setter Target="Frame.BorderBrush" Value="{ThemeResource MonitorDanger}" />
                </VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Frame" Style="{StaticResource MonitorCard}" BorderBrush="{ThemeResource MonitorAccent}" Padding="10,9" MinHeight="56">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                <controls:WidgetIcon x:Name="MetricIcon" x:Load="{x:Bind ShowIcon}" IconName="{x:Bind Model.IconName}" Tone="{x:Bind Model.Tone, Mode=OneWay}" Width="26" Height="26" VerticalAlignment="Center" />
                <TextBlock x:Name="MetricLabel" Grid.Column="1" Text="{x:Bind DisplayLabel}" Foreground="{ThemeResource MonitorForeground}" FontSize="15" VerticalAlignment="Center"
                    TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Model.Label}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="ValueText" Text="{x:Bind Model.Value, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                        Foreground="{ThemeResource MonitorForeground}" MaxWidth="210" TextWrapping="Wrap" TextAlignment="Right" ToolTipService.ToolTip="{x:Bind Model.Value, Mode=OneWay}" />
                    <Ellipse x:Name="Indicator" Width="4" Height="4" Fill="{ThemeResource MonitorAccent}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
