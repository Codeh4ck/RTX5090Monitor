<UserControl x:Class="Rtx5090Monitoring.App.Controls.SectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource MonitorCard}" Padding="0">
        <Grid RowDefinitions="Auto,*">
            <Border x:Name="HeaderFrame" BorderBrush="{ThemeResource MonitorBorder}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                    <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource MonitorSectionHeading}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ContentPresenter Grid.Column="1" Content="{x:Bind HeaderActions, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="18">
                <ContentPresenter Content="{x:Bind Body, Mode=OneWay}" HorizontalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Border>
</UserControl>
