<Project>
    <Import Project="../Directory.Build.props" />
    <PropertyGroup>
        <InstallerVersion Condition="'$(InstallerVersion)' == ''">$(ReleaseVersion)</InstallerVersion>
        <InstallerPlatform>x64</InstallerPlatform>
        <AcceptEula>wix7</AcceptEula>
        <PayloadDirectory Condition="'$(PayloadDirectory)' == ''">$(MSBuildThisFileDirectory)../artifacts/installer-payload</PayloadDirectory>
    </PropertyGroup>
</Project>
