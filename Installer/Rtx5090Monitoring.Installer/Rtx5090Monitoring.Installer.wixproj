<Project Sdk="WixToolset.Sdk/7.0.0">
    <PropertyGroup>
        <OutputName>RtxMonitor-$(InstallerVersion)-win-x64</OutputName>
        <OutputPath>bin/x64/$(Configuration)/</OutputPath>
        <!-- WinUI's signed multilingual DLLs contain long language lists and modern LCIDs unknown to ICE03.
             The installer tests validate this exception against the actual payload; all other ICEs remain enabled. -->
        <SuppressIces>ICE03</SuppressIces>
        <DefineConstants>$(DefineConstants);InstallerVersion=$(InstallerVersion);PayloadDirectory=$(PayloadDirectory)</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" />
        <PackageReference Include="WixToolset.Util.wixext" />
        <ProjectReference Include="../Rtx5090Monitoring.Installer.Actions/Rtx5090Monitoring.Installer.Actions.csproj" />
    </ItemGroup>
    <Target Name="RequirePublishedPayload" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(PayloadDirectory)/Service/Rtx5090Monitoring.Service.exe')" Text="Publish the installer payload with scripts/Build-Release.ps1 before building the MSI." />
        <Error Condition="!Exists('$(PayloadDirectory)/Desktop/Rtx5090Monitoring.App.pri')" Text="The desktop publish payload is incomplete." />
    </Target>
</Project>
